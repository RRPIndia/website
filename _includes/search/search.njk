<div class="search-container" role="search">
  <div class="search-input-wrapper">
    <span class="search-icon" aria-hidden="true">🔍</span>
    <input
      type="search"
      id="site-search-input"
      class="search-input"
      placeholder="Search all archives (English & Hindi)..."
      autocomplete="off"
      aria-label="Search site content"
    >
  </div>

  <!-- Dynamic Filter Dropdowns -->
  <div class="search-filters-bar" id="search-filters-bar">
    <div class="search-filter-group">
      <label for="filter-author">Author:</label>
      <select id="filter-author" class="search-filter-select">
        <option value="">All Authors</option>
      </select>
    </div>

    <div class="search-filter-group">
      <label for="filter-group">Group:</label>
      <select id="filter-group" class="search-filter-select">
        <option value="">All Groups</option>
      </select>
    </div>
  </div>

  <div id="search-results-wrapper" class="search-results" hidden>
    <ul id="search-results-list" class="search-results-list"></ul>
  </div>
</div>

<script type="module" src="/assets/search.js"></script>

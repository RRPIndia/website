{% if eleventyNavigation and eleventyNavigation.key %}
  {% set navCrumbs = collections.all | eleventyNavigationBreadcrumb(eleventyNavigation.key, { includeSelf: true, allowMissing: true }) %}
{% else %}
  {% set navCrumbs = [] %}
{% endif %}

{% if navCrumbs.length > 1 %}
<nav class="breadcrumb" aria-label="Breadcrumb">
  {% for crumb in navCrumbs %}
    {% if not loop.first %}
      <span class="crumb-sep">›</span>
    {% endif %}
    {% if loop.last %}
      <a href="{{ crumb.url }}">
        {{ crumb.title or crumb.key }}
      </a>
    {% else %}
      {% if crumb.url %}
        <a href="{{ crumb.url }}">
          {{ crumb.title or crumb.key }}
        </a>
      {% else %}
        <span class="crumb-disabled">
          {{ crumb.title or crumb.key }}
        </span>
      {% endif %}
    {% endif %}
  {% endfor %}
</nav>
{% endif %}

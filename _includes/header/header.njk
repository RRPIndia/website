<header data-pagefind-ignore class="elv-header{% if headerClass %} {{ headerClass }}{% endif %}">
  <div class="page-container elv-header-inner">

    <!-- ROW 1: Party name -->
    <div class="header-brand">
      <a href="/">
      <span class="brand-link" >
        Right to Recall<br>
        Party </span>
      </a>
    </div>

    <!-- ROW 2: Sections -->
    {% include "header/section.njk" %}
    
    <!-- ROW 3: Search -->
    <div class="header-search">
      <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
      <script src="/pagefind/pagefind-ui.js"></script>

      <div id="search"></div>

      <script>
        window.addEventListener('DOMContentLoaded', () => {
          new PagefindUI({
            element: "#search",
	    showEmptyFilters: false,
            showSubResults: true
          });
        });
      </script>
    </div>

    <!-- ROW 3.5: Display Settings -->
    <div class="display-settings">
      <details>
        <summary>
          <span class="setting-label">font size</span>
          <div class="setting-controls">
            <button id="btn-font-dec" class="setting-btn" aria-label="Decrease font size">-</button>
            <button id="btn-font-inc" class="setting-btn" aria-label="Increase font size">+</button>
          </div>
        </summary>
        <div class="setting-item">
          <span class="setting-label">line space</span>
          <div class="setting-controls">
            <button id="btn-line-dec" class="setting-btn" aria-label="Decrease line spacing">-</button>
            <button id="btn-line-inc" class="setting-btn" aria-label="Increase line spacing">+</button>
          </div>
        </div>
      </details>
    </div>

    <!-- ROW-4  -->
    {% include "header/lang-switcher.njk" %}

  </div>
</header>

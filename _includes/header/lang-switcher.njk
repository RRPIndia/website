{% set targetUrl = page.url | translatedUrl(lang) %}

<div class="btn-group">
  <a href="{{ targetUrl }}" id="lang-switch-link" class="lang-switch-btn" data-current-url="{{ page.url }}" title="Switch Language">
    <span class="lang-lbl {% if lang == 'hi' %}active{% endif %}">हि</span>
    <span class="lang-sep">।</span>
    <span class="lang-lbl {% if lang == 'en' %}active{% endif %}">en</span>
  </a>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const link = document.getElementById('lang-switch-link');
    if (!link) return;

    const currentUrl = link.dataset.currentUrl;
    const currentLang = "{{ lang }}"; 
    const targetLang = currentLang === 'en' ? 'hi' : 'en';

    const saveKey = 'return_path_' + currentLang;
    const lookupKey = 'return_path_' + targetLang;

    const justSwitched = sessionStorage.getItem('just_switched');
    const savedReturnPath = sessionStorage.getItem(lookupKey);
    const isCurrentlyHome = (currentUrl === '/' || currentUrl === '/hi/');

    if (justSwitched === 'true') {
      sessionStorage.removeItem('just_switched');
    } else {
      sessionStorage.removeItem('return_path_en');
      sessionStorage.removeItem('return_path_hi');
    }

    if (isCurrentlyHome && sessionStorage.getItem(lookupKey)) {
      link.setAttribute('href', sessionStorage.getItem(lookupKey));
    }

    link.addEventListener('click', () => {
      sessionStorage.setItem(saveKey, currentUrl);
      sessionStorage.setItem('just_switched', 'true');

      if (isCurrentlyHome && sessionStorage.getItem(lookupKey)) {
        sessionStorage.removeItem(lookupKey);
      }
    });
  });
</script>

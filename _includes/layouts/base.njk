<!DOCTYPE html>
<html lang="{{ lang }}">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <meta name="google-site-verification"
        content="nOVhyCaoXpjBXXPo-CqrEgfb2rKBCeNpaKtmZ-xNaeM">


<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-HHVG075GJS"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-HHVG075GJS');

 (function() {
      const size = localStorage.getItem('user-font-size');
      const font = localStorage.getItem('user-font-family');
      const lh = localStorage.getItem('user-line-height');
      
      const root = document.documentElement;
      if (size) root.style.setProperty('--font-size', size + 'rem');
      if (font) root.style.setProperty('--font-family', font);
      if (lh) root.style.setProperty('--line-height', lh);
    })();

</script>


  <title>{{ title or "Right to Recall Party" }}</title>

  <link rel="stylesheet" href="/assets/bundle.css">
  <script src="/assets/bundle.js" defer></script>

</head>

<body>

        {# HEADER (global navigation) #}
        {% include "header/header.njk" %}


  {# MAIN CONTENT #}
  <!-- Add data-pagefind-body here so Pagefind knows what to index -->
  <main data-pagefind-body>
    <div class="page-container content">
        {% include "header/breadcrumb.njk" %}
        {{ content | safe }}
    </div>
  </main>

  {% include "footer/footer.html" %}

</body>
</html>


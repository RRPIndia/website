---
layout: layouts/base.njk
pagination:
  data: collections.postsByYear
  size: 1
  alias: yearData
permalink: "fb-export/{{ yearData.year }}/index.html"
---

<h2>Months in {{ yearData.year }}</h2>

<ul>
  {% for m in yearData.months %}
    <li>
      <a href="/fb-export/{{ yearData.year }}/{{ m }}/">
        {{ yearData.year }}-{{ m }}
      </a>
    </li>
  {% endfor %}
</ul>

<!-- AUTOMATIC YEAR NAVIGATION -->
<nav class="post-navigation">
  {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous }}" class="nav-btn">
      ← Newer Year
    </a>
  {% endif %}

  {% if pagination.href.next %}
    <a href="{{ pagination.href.next }}" class="nav-btn">
      Older Year →
    </a>
  {% endif %}
</nav>

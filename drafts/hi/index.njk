---
title: सभी कानूनों की सूची
layout: layouts/base.njk
---

<h1>हिंदी ड्राफ्ट्स</h1>

{% set posts = collections.draft | sort(false, true, "data.draftNumber") %}

{% for post in posts %}
  {% if post.data.lang == lang and post.data.draftNumber %}

    {% set gistPath = "drafts/" + post.fileSlug + "/gist.hi.md" %}

    <article class="draft">
      <h2>
        <a href="{{ post.url }}">
          {{ post.data.draftNumber }}. {{ post.data.title }}
        </a>
      </h2>

      <div class="gist">
        {% include gistPath %}
      </div>

      <p><a href="{{ post.url }}">पूरा ड्राफ्ट पढ़ें →</a></p>
    </article>

    <hr>

  {% endif %}
{% endfor %}
